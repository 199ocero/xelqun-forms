<?php

namespace {{ namespace }};

use {{ modelNamespace }}\{{ model }};
use Illuminate\Contracts\Auth\Authenticatable;
use Illuminate\Database\Eloquent\Model;
use Xelqun\Forms\Components\TextInput;
use Xelqun\Forms\Form;

class {{ class }} extends Form
{
    public function model(): string
    {
        return {{ model }}::class;
    }

    /**
     * This runs on every request the form makes, including search, uploads
     * and live updates. It allows everything until you add your own check.
     */
    public function authorize(?Authenticatable $user, ?Model $record): bool
    {
        return true;
    }

    public function schema(): array
    {
        return [
            TextInput::make('{{ column }}')->required(),
        ];
    }
}
