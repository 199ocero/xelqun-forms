{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUncheckedIndexedAccess": false,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "jsx": "preserve",
        "types": ["vite/client"],
        "noEmit": true,
        "paths": {
            "@xelqun/forms": ["./resources/js/index.ts"],
            "@xelqun/forms/testing": ["./resources/js/testing.ts"]
        }
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.vue",
        "stubs/*.vue",
        "tests/js/**/*.ts",
        "tests/Fixtures/ExamplePlugin/resources/js/**/*.ts",
        "tests/Fixtures/ExamplePlugin/resources/js/**/*.vue"
    ]
}
